# Credenciales ResourceSpace / ByteBox (NUNCA subir .env real a Git)
RESOURCESPACE_BASE_URL=https://tu-instancia-resourcespace/api/
RESOURCESPACE_USER=tu_usuario
RESOURCESPACE_PRIVATE_KEY=tu_clave_privada_api

# Configuración de despliegue Reflex tras proxy reverso Nginx (/IA_videos/)
REFLEX_FRONTEND_PATH=/IA_videos
REFLEX_FRONTEND_PORT=8503
REFLEX_BACKEND_PORT=8504
# En producción con dominio público HTTPS detrás de Nginx:
# REFLEX_API_URL=https://tu-dominio.edu.co/IA_videos
REFLEX_API_URL=http://localhost:8504
